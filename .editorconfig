root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{js,mjs,ts,mts,tsx}]
indent_size = 2

[*.{json,yml,yaml}]
indent_size = 2

[*.sql]
indent_size = 2

[*.ps1]
end_of_line = crlf
