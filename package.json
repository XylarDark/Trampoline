{
  "name": "trampoline",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "demo": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-demo.ps1",
    "demo:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-demo.ps1",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check:contrast": "node scripts/contrast-check.mjs",
    "doctor": "npm run doctor --prefix .devenv",
    "doctor:fix": "npm run doctor:fix --prefix .devenv",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx --env-file=.env.local src/db/seed.ts",
    "db:up": "docker compose up -d",
    "db:demo": "tsx scripts/demo-db.ts",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@base-ui/react": "^1.8.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.42.0",
    "next": "16.3.4",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "^8.0.11",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26.4.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10",
    "eslint-config-next": "16.3.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^7",
    "vitest": "^5.0.0"
  }
}
