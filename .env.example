# Postgres — matches docker-compose.yml
# Change localhost to 127.0.0.1 when using `npm run db:demo`: the PGlite socket
# server binds IPv4 only, and on Windows localhost resolves to ::1 first, which
# fails to connect.
DATABASE_URL=postgres://trampoline:trampoline@localhost:5432/trampoline

# Set to `pglite` when the database is `npm run db:demo` rather than Docker.
# PGlite serves one query at a time and has no prepared statements, so this
# narrows the pool to a single unprepared connection. Leave blank for Docker.
DATABASE_DRIVER=

# Auth.js — generate with: npx auth secret
AUTH_SECRET=replace-me

# Email magic-link sender (Auth.js Nodemailer provider).
# Leave blank for local development: sign-in links are printed to the server console.
AUTH_EMAIL_SERVER=
AUTH_EMAIL_FROM=no-reply@localhost

# Base URL used when building share links
NEXT_PUBLIC_APP_URL=http://localhost:3000
